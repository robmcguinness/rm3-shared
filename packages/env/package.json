{
  "name": "@rm3/env",
  "version": "0.0.0",
  "private": true,
  "description": "Type-safe environment variables with Zod validation",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./load": {
      "types": "./src/load.ts",
      "default": "./src/load.ts"
    }
  },
  "scripts": {
    "test": "node --test 'src/**/*.test.ts'"
  },
  "dependencies": {
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@rm3/typescript-config": "workspace:*",
    "@types/node": "^26.1.2",
    "typescript": "^7.0.2"
  }
}
