{
  "name": "rm3-shared",
  "version": "0.0.0",
  "private": true,
  "description": "Shared Claude plugin, lint/format/tsconfig presets, and small libraries for rm3 projects",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "prepare": "lefthook install",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc -b",
    "test": "pnpm -r --if-present test",
    "check": "lefthook run check --no-tty"
  },
  "devDependencies": {
    "@rm3/lefthook-config": "workspace:*",
    "@rm3/oxfmt-config": "workspace:*",
    "@rm3/oxlint-config": "workspace:*",
    "@rm3/typescript-config": "workspace:*",
    "@types/node": "^26.1.2",
    "lefthook": "^2.1.12",
    "oxfmt": "^0.65.0",
    "oxlint": "1.80.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@12.4.2"
}
